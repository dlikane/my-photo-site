{
  "functions": {
    "api/*.js": {
      "memory": 1024
    }
  },
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  },
  "rewrites": [
    { "source": "/about", "destination": "/" },
    { "source": "/category/:match*", "destination": "/" },
    { "source": "/videos", "destination": "/" }
  ]
}
